table inet collection_egress {
    set special_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24, 192.168.0.0/16,
            192.175.48.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
            224.0.0.0/4, 240.0.0.0/4, 168.63.129.16
        }
    }
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        iifname "lo" accept
        iifname "clients0" tcp dport 3128 accept
    }
    chain output {
        # Docker rewrites its embedded DNS port in OUTPUT at dstnat (-100).
        type filter hook output priority -101; policy drop;
        ct direction reply ct state established,related accept
        oifname "lo" ip daddr 127.0.0.11 meta l4proto { tcp, udp } th dport 53 accept
        ip daddr @special_ipv4 reject
        oifname "uplink0" meta nfproto ipv4 tcp dport 443 accept
    }
}
